<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.heimdall.backend</string>
	<key>ProgramArguments</key>
	<array>
		<string>/PATH/TO/graftd</string>
		<string>--config</string>
		<string>/PATH/TO/.graft/config.yaml</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/PATH/TO/backend.log</string>
	<key>StandardErrorPath</key>
	<string>/PATH/TO/backend.log</string>
</dict>
</plist>
